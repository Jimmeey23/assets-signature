# Copy to server/.env and fill in.
#
# Use an API token from Mailtrap → Email Sending (not the Testing sandbox).
# Create one at: https://mailtrap.io/api-tokens (under your verified sending domain).
# MAILTRAP_FROM must be an address on a domain you have VERIFIED in Mailtrap.

# ── Mailtrap Email Sending REST API ──
MAILTRAP_HOST=send.api.mailtrap.io
MAILTRAP_PATH=/api/send
MAILTRAP_API_TOKEN=

# ── Envelope ──
MAILTRAP_FROM=
MAILTRAP_FROM_NAME=AMP Fitness · Asset Declarations
# Recipient is fixed to jimmeey@physique57india.com

# ── Server ──
PORT=3001
ALLOWED_ORIGIN=*
DISPLAY_TZ=Asia/Kolkata
